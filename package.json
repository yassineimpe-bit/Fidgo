{
  "name": "fidgo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "env:check": "node scripts/validate-env.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "db:verify": "node scripts/verify-db-integrity.mjs",
    "bootstrap:demo": "npm run db:setup && npm run db:seed:demo && npm run db:verify"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "google-auth-library": "11.0.2",
    "jose": "5.9.6",
    "next": "15.5.24",
    "passkit-generator": "3.6.0",
    "postgres": "3.4.5",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^22.12.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.0.6",
    "@types/react-dom": "19.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "joi": "17.13.6",
    "postcss": "8.5.23"
  }
}
