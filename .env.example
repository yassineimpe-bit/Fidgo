# Core
DATABASE_URL=postgres://user:password@host:5432/loyalty?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-bytes
NEXT_PUBLIC_APP_URL=https://retiko.fr
# Protege /api/cron/purge (purge quotidienne de rate_limits). Vercel Cron
# envoie automatiquement "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Demo bootstrap (optional)
DEMO_SLUG=retiko-demo
DEMO_RESTAURANT_NAME=Retiko Demo
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=

# Wallet feature flags
APPLE_WALLET_ENABLED=false
GOOGLE_WALLET_ENABLED=false

# Apple Wallet / PassKit
APPLE_PASS_TYPE_IDENTIFIER=pass.fr.retiko
APPLE_TEAM_IDENTIFIER=
APPLE_WWDR_CERT_BASE64=
APPLE_SIGNER_CERT_BASE64=
APPLE_SIGNER_KEY_BASE64=
APPLE_SIGNER_KEY_PASSPHRASE=

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=

# Web Push - later
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@retiko.fr

# Stripe Billing (disabled by default; server-side hosted Checkout only)
STRIPE_ENABLED=false
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FLEX_MONTHLY=
STRIPE_PRICE_RETIKO12_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Grille proposée aux nouveaux abonnements : pilot (défaut) ou standard (25 € / 250 € HT).
BILLING_PRICE_GRID=pilot
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=

# Transactional email. RESEND_* is required for public merchant signup
# verification in production. CARD_RECOVERY_ENABLED only controls card recovery.
CARD_RECOVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Retiko <cartes@retiko.fr>
EMAIL_REPLY_TO=contact@retiko.fr

# Diagnostic ponctuel de la latence de connexion : journalise les durées par phase
# (LOGIN_TIMING) côté serveur uniquement. Laisser désactivé hors diagnostic.
# LOGIN_TIMING_LOG=1
