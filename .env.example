# Core
DATABASE_URL=postgres://user:password@host:5432/loyalty?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-bytes
NEXT_PUBLIC_APP_URL=https://retiko.fr

# Demo bootstrap (optional)
DEMO_SLUG=retiko-demo
DEMO_RESTAURANT_NAME=Retiko Demo
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=

# Wallet feature flags
APPLE_WALLET_ENABLED=false
GOOGLE_WALLET_ENABLED=false

# Apple Wallet / PassKit
APPLE_PASS_TYPE_IDENTIFIER=pass.fr.retiko
APPLE_TEAM_IDENTIFIER=
APPLE_WWDR_CERT_BASE64=
APPLE_SIGNER_CERT_BASE64=
APPLE_SIGNER_KEY_BASE64=
APPLE_SIGNER_KEY_PASSPHRASE=

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=

# Web Push - later
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@retiko.fr

# Stripe - later
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email card recovery (P0 before pilot; enable only after migration 004 + verified sender domain)
CARD_RECOVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Retiko <noreply@retiko.fr>
