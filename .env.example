# Core
DATABASE_URL=postgres://user:password@host:5432/loyalty?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-bytes
NEXT_PUBLIC_APP_URL=https://loyalty.example.com

# Feature flags Wallet (off until credentials are configured)
APPLE_WALLET_ENABLED=false
GOOGLE_WALLET_ENABLED=false

# Apple Wallet - Priority 2
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_WWDR_CERT_BASE64=
APPLE_PASS_CERT_BASE64=
APPLE_PASS_CERT_PASSWORD=

# Google Wallet - Priority 2
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=

# Web Push - Priority 2
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Stripe - Priority 3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email - later
RESEND_API_KEY=
EMAIL_FROM=
