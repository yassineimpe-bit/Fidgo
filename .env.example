# Core
DATABASE_URL=postgres://user:password@host:5432/loyalty?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-bytes
NEXT_PUBLIC_APP_URL=https://fidgo.example.com

# Demo bootstrap (optional)
DEMO_SLUG=fidgo-demo
DEMO_RESTAURANT_NAME=Fidgo Demo
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=

# Wallet feature flags
APPLE_WALLET_ENABLED=false
GOOGLE_WALLET_ENABLED=false

# Apple Wallet / PassKit
APPLE_PASS_TYPE_IDENTIFIER=pass.com.example.fidgo
APPLE_TEAM_IDENTIFIER=
APPLE_WWDR_CERT_BASE64=
APPLE_SIGNER_CERT_BASE64=
APPLE_SIGNER_KEY_BASE64=
APPLE_SIGNER_KEY_PASSPHRASE=

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=

# Web Push - later
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Stripe (offre unique Fidgo, mensuel ou annuel, 30 jours d'essai)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email card recovery (enable only after migration 004 is applied)
CARD_RECOVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
